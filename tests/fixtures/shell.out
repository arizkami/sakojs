echo               "hello world\n"
echo -n/-e         "ab\tc\n"
quotes             "single  $HOME double  interp esc aped\n"
interp escape      "a; rm -rf / && $(boom) x y z premidpost\n"
raw                "raw  text\n"
vars               "bar ${FOO} $FOO\n"
$?                 "1\n0\n"
&& ||              "yes\nyes2\n"
subst              "[inner\ntwo] a b\n"
tilde              true
cd/pwd             true
cwd unchanged      true
exit               [3,"before\n",""]
seq/basename       "2\n3\n4\nc\n/a/b\n"
cat                "one\ntwo\n"
ls                 "A.txt\nb.js\nf1.txt\nsub\n"
glob               "A.txt f1.txt\n"
glob none          "*.nope\n"
stdin redirect     "one\ntwo\n"
stdin buffer       "from buffer\n"
2> file            [0,"cat: missing.txt: No such file or directory\n",""]
2>&1               [1,"cat: missing.txt: No such file or directory\n",""]
&> file            [0,"cat: missing.txt: No such file or directory\none\ntwo\n",""]
cp/mv/rm           "A.txt\nboth.txt\nd.txt\nerr.txt\n"
wc                 "50 nums.txt\n50\n      1       2       4\n"
head/tail          "1\n2\n48\n49\n50\n49\n50\n"
grep               "14\n4:4\n40:40\n41:41\n42:42\n43:43\n44:44\n45:45\n46:46\n47:47\n48:48\n49:49\n9\n5\n"
grep none          [1,"",""]
sort/uniq          "      2 a\n      2 b\n      1 c\n"
sort -rn           "50\n49\n48\n"
external           "from process\n"
ext pipe           "5\n"
ext stdin buf      100000
ext 2>&1           [true,true]
ext > file         "to file\n"
prefix env         ["SAKO_X=42"]
.env()             ["ONLY=1"]
not found          [127,"","sako: command not found: no-such-command\n"]
unsupported flag   true
ShellError         ["ShellError",7,true,"Failed with exit code 7"]
nothrow            2
json               {"a":[1,2]}
lines()            ["1","2","3"]
bytes              [104,105]
escape             ["plain","\"a b'c\\$\""]
syntax error       "Sako.$: subshells ( ... ) are not supported"
--- printed by default:
printed
also printed
